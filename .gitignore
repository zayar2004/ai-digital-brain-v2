# ================================================================
# AI DIGITAL BRAIN — .gitignore
# ================================================================

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environments ───
venv/
env/
ENV/
.venv
.env.*.local

# ─── Environment (NEVER commit) ───
.env
.env.bak*
.env.local
.env.production
.env.development

# ─── Database (NEVER commit) ───
instance/
*.db
*.sqlite3
*.sqlite
app.db
workai.db

# ─── Backups (NEVER commit) ───
backups/
.bot_backup_*/
.auto_backup_*/
.step4_backup/
*.bak
*.bak_*
*.bak2
*.bak3
*.broken
*.messy
*.old
*.orig
*~

# ─── Logs ───
logs/
*.log
*.log.*

# ─── Uploads (user data) ───
uploads/
media/
files/

# ─── Process / State ───
*.pid
.backup_loop.pid
*.lock

# ─── IDE / Editors ───
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Test files ───
Machine_Code_A3_test.xlsx
*.test.xlsx

# ─── GitHub workflow exceptions ───
!.gitignore
!.env.example
.secret_key.txt
