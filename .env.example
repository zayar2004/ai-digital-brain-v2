# ─── Flask ───
SECRET_KEY=change-me-random-32-chars
FLASK_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# ─── Telegram ───
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_API_BASE=http://127.0.0.1:5000

# ─── Database ───
DATABASE_URL=sqlite:///instance/ai_brain.db

# ─── Logging ───
LOG_LEVEL=INFO
LOG_DIR=logs

# ─── Admin ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── Failover (optional) ───
FAILOVER_ENABLED=false
FAILOVER_ADMIN_CHAT_ID=
FAILOVER_HEARTBEAT_INTERVAL=300
FAILOVER_TIMEOUT=900
